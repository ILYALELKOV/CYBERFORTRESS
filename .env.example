# CYBERFORTRESS — пример .env. Копируется в .env и заполняется реальными значениями.
# Файл .env в git коммитить НЕЛЬЗЯ.

# Synology NAS (например DS920+, DS220+, DS423 и т.д.)
SYNOLOGY_HOST=192.168.X.X
SYNOLOGY_USER=admin
SYNOLOGY_PASS=your-password-here
SYNOLOGY_PORT=22

# Router (пусто = автодетект через default gateway)
ROUTER_HOST=
ROUTER_MODEL=ASUS RT-AX89X
ROUTER_USER=admin
ROUTER_PASS=your-router-password
ROUTER_PORT=22

# Dashboard
DASHBOARD_TITLE=CYBERFORTRESS // SYSTEM CONTROL
DASHBOARD_OPERATOR=YOU

# GitHub token для повышения rate-limit (60/час → 5000/час). Опционально.
GITHUB_TOKEN=

# Proxy panel URLs (приватные, не попадают в репозиторий)
PROXY_RIGA_URL=
PROXY_AMSTERDAM_URL=
